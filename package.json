    "@types/node": "22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
